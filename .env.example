# ===================================
# NgolabHub Member Affiliate Hub - Environment Configuration
# ===================================
# Salin file ini menjadi .env dan sesuaikan nilai-nilainya dengan environment Anda

# Central Backend API URL (untuk semua endpoint: login, register, KYC verify, profile, dll)
# Format: http://IP:PORT atau http://HOSTNAME:PORT
# Ganti IP/HOSTNAME sesuai dengan server backend Anda
VITE_CENTRAL_API_URL=http://192.168.77.211:4000

# ===================================
# Contoh Konfigurasi untuk Development
# ===================================
# VITE_CENTRAL_API_URL=http://192.168.77.211:4000
# VITE_CENTRAL_API_URL=http://192.168.1.100:4000

# ===================================
# Contoh Konfigurasi untuk Production
# ===================================
# VITE_CENTRAL_API_URL=https://api.ngolabhub.com:4000
# VITE_CENTRAL_API_URL=http://api.production.local:4000

# ===================================
# Legacy Variables (untuk backward compatibility)
# ===================================
# REACT_APP_API_BASE_URL=http://192.168.77.211:4000
